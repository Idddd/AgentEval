# Langfuse local stack bootstrap (demo only, local machine)
# Copy to langfuse/.env — docker compose reads it automatically.
LANGFUSE_INIT_ORG_ID=agent-eval-org
LANGFUSE_INIT_ORG_NAME=AgentEval
LANGFUSE_INIT_PROJECT_ID=agent-eval-project
LANGFUSE_INIT_PROJECT_NAME=agent-eval
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-local-demo-0000000000000001
LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-local-demo-0000000000000001
LANGFUSE_INIT_USER_EMAIL=demo@local.dev
LANGFUSE_INIT_USER_NAME=demo
LANGFUSE_INIT_USER_PASSWORD=demo12345
