# Server-side NeMo business-user PAT, raw value without the Bearer prefix.
# Never fill this example with real credentials in Git.
GUARD_API_TOKEN=REPLACE_WITH_NEMO_TOKEN
# Alternative: mount a Secret file (takes precedence over GUARD_API_TOKEN).
# GUARD_API_TOKEN_FILE=/run/secrets/nemo-token
# Password mode: remove BOTH token variables above before using these:
# GUARD_USERNAME=service-account@example.internal
# GUARD_PASSWORD=REPLACE_WITH_ACCOUNT_PASSWORD
# Prefer a mounted secret file over GUARD_PASSWORD when running directly:
# GUARD_PASSWORD_FILE=/run/secrets/nemo-password
# If the API uses an internal host, provide NeMo's configured trusted origin:
# GUARD_AUTH_ORIGIN=https://nemo.example.internal
