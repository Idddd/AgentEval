# Default V3 needs exactly these three connection inputs.
GUARD_API_URL=https://nemo.internal/api/v1
# Inject existing business Token and full DB URL from Secrets; examples only.
GUARD_API_TOKEN=REPLACE_WITH_BUSINESS_TOKEN
MARKETPLACE_DATABASE_URL=postgresql://marketplace:REPLACE_WITH_PASSWORD@postgresql.internal:5432/marketplace_uat
# MariaDB: mariadb://marketplace:ENCODED_PASSWORD@mariadb.internal:3306/marketplace_uat
# Same-page connection setup supports all three and optional TLS/CA/workspace/F5.
# For local Docker persistence, mount this directory as a named/bind volume:
# MARKETPLACE_CONNECTION_DIR=/var/lib/marketplace/connection
# MARKETPLACE_CONNECTION_PERSISTENT=true
# Strict identity mode is optional; not required for the role-switching demo:
# MARKETPLACE_V3_DEMO=false
# TLS/CA settings can be supplied through deployment or the same V3 page.
# MARKETPLACE_DB_TLS=true
# NODE_EXTRA_CA_CERTS=/opt/marketplace/ca/ca.crt
# MARKETPLACE_DB_CA_FILE=/opt/marketplace/ca/ca.crt
