MARKETPLACE_DATA_MODE=live
MARKETPLACE_CRUD_ONLY=false
MARKETPLACE_F5_MOCK=false
GUARD_API_URL=https://nemo.internal/api/v1
# When NeMo uses a different trusted public origin, set it here (no path):
# GUARD_AUTH_ORIGIN=https://nemo.internal
MARKETPLACE_PUBLIC_ORIGIN=https://marketplace.internal
MARKETPLACE_DATABASE_URL=postgresql://marketplace@postgresql.internal:5432/marketplace_uat
# Inject from a Secret; an independent password overrides any password in the URL.
# MARKETPLACE_DATABASE_PASSWORD=REPLACE_WITH_APPLICATION_ACCOUNT_PASSWORD
# MariaDB alternative: mariadb://marketplace@mariadb.internal:3306/marketplace_uat
MARKETPLACE_DB_TLS=true
MARKETPLACE_V2_ACCOUNTS_FILE=/opt/marketplace/accounts/accounts.json
MARKETPLACE_WORKSPACE_ID=uat
# Local test access only; leave disabled for OCP / non-loopback origins.
MARKETPLACE_V2_LOCAL_ACCESS=false
# MARKETPLACE_V2_LOCAL_ACTOR_ID=USER_ID_FROM_ACCOUNTS_JSON
# NeMo credentials are supplied separately with nemo.env / a mounted Secret.
# NODE_EXTRA_CA_CERTS=/opt/marketplace/ca/ca.crt
# MARKETPLACE_DB_CA_FILE=/opt/marketplace/ca/ca.crt
# Optional F5 (enable URL + token together; never put a real token in the image):
# F5_API_URL=https://f5.internal/backend/v1
# F5_API_TOKEN_FILE=/opt/marketplace/f5/token
# F5_PROJECT_ADMIN_IDS=F5_USER_ID
