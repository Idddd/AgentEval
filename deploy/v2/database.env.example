# PostgreSQL UAT; host, username and database come from the actual Secret URL.
MARKETPLACE_DATABASE_URL=postgresql://marketplace@postgresql.internal:5432/marketplace_uat
# Raw password; overrides an embedded URL password. Do not URL-encode this value.
MARKETPLACE_DATABASE_PASSWORD=REPLACE_WITH_APPLICATION_ACCOUNT_PASSWORD
# After disposable UAT, point the same image at an empty MariaDB database:
# MARKETPLACE_DATABASE_URL=mariadb://marketplace@mariadb.internal:3306/marketplace_uat
# Existing full URLs with URL-encoded passwords remain supported if the separate password is absent.
