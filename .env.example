# DeepSeek via Anthropic-compatible endpoint (takes priority over OpenAI)
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_MODEL=deepseek-v4-flash

# OpenAI: used only when the Anthropic-compatible settings above are absent
OPENAI_API_KEY=

# LangSmith: if the key is empty or connectivity probe fails, Local JSON is used (data/ dir)
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=
LANGSMITH_WORKSPACE_ID=
