# Copy to .env. Non-secret configuration only — secrets go in .env.secret
# (copy .env.secret.example). .env.secret is loaded after .env and overrides it.

# DeepSeek via Anthropic-compatible endpoint (takes priority over OpenAI)
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
ANTHROPIC_MODEL=deepseek-v4-flash

# OpenAI-compatible endpoint override (e.g. Alibaba Cloud Model Studio / DashScope);
# leave empty for api.openai.com
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_MODEL=qwen-plus

# Langfuse: http://localhost:3000 for self-hosted, https://cloud.langfuse.com for cloud.
# If keys (in .env.secret) are empty or auth fails, falls back to local JSON mode (data/ dir)
LANGFUSE_HOST=https://cloud.langfuse.com
