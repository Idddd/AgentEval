# DeepSeek via Anthropic-compatible endpoint (takes priority over OpenAI)
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_MODEL=deepseek-v4-flash

# OpenAI: used only when the Anthropic-compatible settings above are absent
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Langfuse: if either key is empty or auth fails, falls back to local JSON mode (data/ dir)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Local workbench state. Docker Compose overrides this to /app/data/workbench.db
# so the named agent-eval-data volume keeps Agents, Datasets, Runs, and Reports.
WORKBENCH_DB=data/workbench.db
