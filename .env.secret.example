# Copy to .env.secret and fill in real values. .env.secret is gitignored.
# Secret values live ONLY here; non-secret settings live in .env (see .env.example).

# Token for the Anthropic-compatible endpoint configured in .env
ANTHROPIC_AUTH_TOKEN=

# API key for OpenAI or an OpenAI-compatible endpoint (e.g. Alibaba Cloud
# Model Studio / DashScope key from the console API-KEY page)
OPENAI_API_KEY=

# Langfuse project keys
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
